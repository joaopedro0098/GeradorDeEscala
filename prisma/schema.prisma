// Gerador de Escala — modelagem multi-tenant (nomenclatura genérica)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum IntervalCountMode {
  BY_EVENT
  BY_DAY_OF_WEEK
}

enum ScheduleStatus {
  DRAFT
  PUBLISHED
}

enum ScheduleGenerationStatus {
  COMPLETE
  INCOMPLETE_BY_SHORTAGE
  INCOMPLETE_BY_TIMEOUT
}

enum GroupMode {
  /// Prioritizes scheduling group members together, but never blocks the
  /// event or generates a blank slot if that isn't possible.
  FLEXIBLE
  /// Attempts to schedule the entire group together; if not feasible for a
  /// given event, none of the group's members are auto-assigned to it
  /// (their slots are left blank rather than split apart).
  STRICT
}

enum NotificationType {
  ADMIN_PROMOTED
  MEMBERSHIP_APPROVED
  MEMBERSHIP_REJECTED
}

enum PlanTier {
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
}

model Organization {
  id                    String                 @id @default(cuid())
  name                  String
  logoUrl               String?
  /// Month the whole organization is working on: schedule, availability and the
  /// event calendar all operate on it. Null falls back to the current month.
  workingYear           Int?
  workingMonth          Int?
  inviteCode            String                 @unique
  planTier              PlanTier               @default(BASIC)
  subscriptionStatus    SubscriptionStatus     @default(TRIAL)
  trialStartedAt        DateTime               @default(now())
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  memberships           Membership[]
  roles                 Role[]
  events                Event[]
  dayOfWeekRequirements DayOfWeekRequirement[]
  participationConfig   ParticipationConfig?
  intervalRule          IntervalRule?
  priorityRoles         PriorityRole[]
  schedules             Schedule[]
  memberGroups          MemberGroup[]
}

model Membership {
  id               String                      @id @default(cuid())
  userId           String
  organizationId   String
  status           MembershipStatus            @default(PENDING)
  isAdmin          Boolean                     @default(false)
  isPrimaryAdmin   Boolean                     @default(false)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  user             User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePreferences  MembershipRolePreference[]
  roleCombinations MembershipRoleCombination[]
  availabilities   Availability[]
  scheduleSlots    ScheduleSlot[]
  notifications    Notification[]
  groupMembership  GroupMembership?

  @@unique([userId, organizationId])
  @@index([organizationId, status])
}

model Role {
  id                    String                      @id @default(cuid())
  organizationId        String
  name                  String
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  organization          Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membershipPreferences MembershipRolePreference[]
  combinationsAsRoleA   MembershipRoleCombination[] @relation("RoleCombinationRoleA")
  combinationsAsRoleB   MembershipRoleCombination[] @relation("RoleCombinationRoleB")
  dayOfWeekRequirements DayOfWeekRequirement[]
  priorityRoles         PriorityRole[]
  scheduleSlots         ScheduleSlot[]

  @@unique([organizationId, name])
}

model MembershipRolePreference {
  id           String     @id @default(cuid())
  membershipId String
  roleId       String
  sortOrder    Int
  createdAt    DateTime   @default(now())
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@unique([membershipId, sortOrder])
}

/// Pair of roles a specific member has marked as safe to accumulate
/// simultaneously in the same event (e.g. "guitar + vocals"). Stored with a
/// canonical order (roleAId < roleBId) so a pair is never duplicated in
/// reverse. Distinct from MembershipRolePreference, which only expresses
/// which roles a member can perform alone and in what order of preference.
model MembershipRoleCombination {
  id           String     @id @default(cuid())
  membershipId String
  roleAId      String
  roleBId      String
  createdAt    DateTime   @default(now())
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  roleA        Role       @relation("RoleCombinationRoleA", fields: [roleAId], references: [id], onDelete: Cascade)
  roleB        Role       @relation("RoleCombinationRoleB", fields: [roleBId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleAId, roleBId])
  @@index([membershipId])
}

/// A named group of 2+ members the admin wants scheduled together, in either
/// FLEXIBLE (soft preference) or STRICT (all-or-nothing) mode. See
/// GroupMembership for the membership-to-group link.
model MemberGroup {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  mode           GroupMode
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        GroupMembership[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Links a membership to at most one group at a time — a person cannot
/// belong to more than one group, which is enforced both here (unique on
/// membershipId alone, not the [groupId, membershipId] pair) and in the
/// service layer when adding a member to a group.
model GroupMembership {
  id           String      @id @default(cuid())
  groupId      String
  membershipId String      @unique
  createdAt    DateTime    @default(now())
  group        MemberGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  membership   Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model Event {
  id             String         @id @default(cuid())
  organizationId String
  date           DateTime       @db.Date
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  availabilities Availability[]
  scheduleSlots  ScheduleSlot[]

  @@unique([organizationId, date])
  @@index([organizationId, date])
}

model DayOfWeekRequirement {
  id             String       @id @default(cuid())
  organizationId String
  dayOfWeek      DayOfWeek
  roleId         String
  quantity       Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dayOfWeek, roleId])
}

model Availability {
  id           String     @id @default(cuid())
  membershipId String
  eventId      String
  createdAt    DateTime   @default(now())
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([membershipId, eventId])
  @@index([eventId])
}

model ParticipationConfig {
  id             String       @id @default(cuid())
  organizationId String       @unique
  minimumDays    Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Single organization-wide interval rule. Per-role rules were removed.
model IntervalRule {
  id             String            @id @default(cuid())
  organizationId String            @unique
  intervalCount  Int
  countMode      IntervalCountMode
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model PriorityRole {
  id             String       @id @default(cuid())
  organizationId String
  roleId         String
  sortOrder      Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([organizationId, roleId])
  @@unique([organizationId, sortOrder])
}

model Schedule {
  id                  String                     @id @default(cuid())
  organizationId      String
  year                Int
  month               Int
  status              ScheduleStatus             @default(DRAFT)
  generationStatus    ScheduleGenerationStatus?
  hasPublishedGaps    Boolean                    @default(false)
  publishedAt         DateTime?
  /// When true, members may only view availability for this month (no edits).
  availabilityLocked  Boolean                    @default(false)
  /// True after regenerating a published schedule (or after undo while members
  /// still see a frozen snapshot). Working copy is a draft until Publish.
  hasPendingDraft     Boolean                    @default(false)
  publishedSnapshotId String?                    @unique
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publishedSnapshot   SchedulePublishedSnapshot? @relation(fields: [publishedSnapshotId], references: [id], onDelete: SetNull)
  previousVersion     SchedulePreviousVersion?
  slots               ScheduleSlot[]

  @@unique([organizationId, year, month])
}

/// Single "undo" slot per schedule — replaced on each save, never accumulated.
model SchedulePreviousVersion {
  id               String                        @id @default(cuid())
  scheduleId       String                        @unique
  savedAt          DateTime                      @default(now())
  statusAtSave     ScheduleStatus
  generationStatus ScheduleGenerationStatus?
  hasPublishedGaps Boolean
  publishedAt      DateTime?
  schedule         Schedule                      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  slots            SchedulePreviousVersionSlot[]
}

model SchedulePreviousVersionSlot {
  id           String                  @id @default(cuid())
  previousId   String
  eventId      String
  roleId       String
  slotIndex    Int                     @default(0)
  membershipId String?
  isManual     Boolean
  isMinister   Boolean
  previous     SchedulePreviousVersion @relation(fields: [previousId], references: [id], onDelete: Cascade)

  @@unique([previousId, eventId, roleId, slotIndex])
  @@index([previousId])
}

/// Frozen member-visible snapshot while hasPendingDraft is true.
model SchedulePublishedSnapshot {
  id               String                          @id @default(cuid())
  frozenAt         DateTime                        @default(now())
  generationStatus ScheduleGenerationStatus?
  hasPublishedGaps Boolean
  publishedAt      DateTime?
  schedule         Schedule?
  slots            SchedulePublishedSnapshotSlot[]
}

model SchedulePublishedSnapshotSlot {
  id           String                    @id @default(cuid())
  snapshotId   String
  eventId      String
  roleId       String
  slotIndex    Int                       @default(0)
  membershipId String?
  isManual     Boolean
  isMinister   Boolean
  snapshot     SchedulePublishedSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, eventId, roleId, slotIndex])
  @@index([snapshotId])
}

model ScheduleSlot {
  id           String      @id @default(cuid())
  scheduleId   String
  eventId      String
  roleId       String
  slotIndex    Int         @default(0)
  membershipId String?
  isManual     Boolean     @default(false)
  isMinister   Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  schedule     Schedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  event        Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  role         Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  membership   Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@unique([scheduleId, eventId, roleId, slotIndex])
  @@index([scheduleId])
}

model Notification {
  id           String           @id @default(cuid())
  membershipId String
  type         NotificationType
  title        String
  message      String
  readAt       DateTime?
  createdAt    DateTime         @default(now())
  membership   Membership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, readAt])
}
